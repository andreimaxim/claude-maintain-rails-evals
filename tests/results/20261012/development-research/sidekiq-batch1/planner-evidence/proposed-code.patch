@@ -58,6 +58,26 @@
     end
   end
 
+  test "a digest job is queued and run through Sidekiq's JSON payload" do
+    release_digest_reservations "2026-10-08"
+    wrapper = ActiveJob::QueueAdapters::SidekiqAdapter::JobWrapper
+    wrapper.clear
+    sidekiq = ActiveJob::QueueAdapters::SidekiqAdapter.new
+    sign_in_as users(:reader)
+
+    travel_to Time.utc(2026, 10, 8, 12) do
+      DigestJob.stub(:perform_later, ->(*args) { DigestJob.new(*args).tap { |job| sidekiq.enqueue(job) } }) do
+        post digest_path
+      end
+      assert_equal "Today's reading digest is on its way.", flash[:notice]
+      payload = wrapper.jobs.sole
+      assert_equal "DigestJob", payload["wrapped"]
+      assert_kind_of String, payload["args"].first["arguments"].third
+      assert_difference(-> { ActionMailer::Base.deliveries.size }, 1) { wrapper.drain }
+    end
+    assert_match(/% of your notes were ready/, ActionMailer::Base.deliveries.last.body.to_s)
+  end
+
   private
     # Reservations are kept in Redis, outside the test database's transactions.
     def release_digest_reservations(*dates)

+# Rich text may contain collapsible excerpts. Extend Action Text's default
+# allowlist, which keeps the sanitizer's safe defaults and attachment markup.
+# Action Text replaces its sanitizer when Action View loads, so this runs after.
+Rails.application.config.after_initialize do
+  ActiveSupport.on_load(:action_view) do
+    ActionText::ContentHelper.allowed_tags =

              "judgmentCall": false
            },
            "levelMatches": true
          },
          "R02": {
            "found": "located",
            "level": "low",
            "accuracy": "accurate",
            "quote": "Positional serialization coder removed in 7.2: [`serialize :tags, JSON`, note.rb:12] needs `coder: JSON`",
            "reason": "",
            "label": {
              "level": "low",
              "default": false,
              "judgmentCall": true
            },
            "levelMatches": true
          },
          "R03": {
            "found": "located",
            "level": "low",
            "accuracy": "accurate",
            "quote": "`alias_attribute` can no longer target a non-column method: [`highlight_color \u2192 color`, note.rb:13\u201314] targets a JSON-store accessor, not a column.",
            "reason": "",
            "label": {
              "level": "low",

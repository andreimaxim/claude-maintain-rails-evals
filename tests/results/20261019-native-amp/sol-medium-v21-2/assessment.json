        "effort": "high",
        "items": {
          "R01": {
            "found": "located",
            "level": "low",
            "accuracy": "accurate",
            "quote": "Keyword-style `enum` is removed in 8.0: change [`enum status: ..., _prefix: true`, note.rb:10] to positional `enum :status, ..., prefix: true`",
            "reason": "",
            "label": {
